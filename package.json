{
  "name": "private-finance-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, single-user Telegram-first personal finance manager.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run security:secrets && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@11.16.0"
}
